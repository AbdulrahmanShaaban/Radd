{
  "name": "radd",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --import ./tests/setup-server-only.ts --test tests/rag.test.ts tests/booking.test.ts tests/chat-tools.test.ts tests/tenant.test.ts",
    "queue:work": "node scripts/tsx-run.mjs scripts/process-jobs.ts",
    "eval:run": "node scripts/tsx-run.mjs scripts/run-evals.ts",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node scripts/tsx-run.mjs prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "^7.10.0",
    "lucide-react": "^1.54.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.6",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.0",
    "typescript-7": "npm:typescript@^7.0.2"
  },
  "packageManager": "pnpm@12.4.2"
}
